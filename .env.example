# Токен главного бота (BotFather). Через него работает вебхук, валидация
# initData и создание паков у юзеров, не подключивших своего бота.
BOT_TOKEN=

# Публичный HTTPS-домен, где живёт этот сервер (WebApp + вебхук на одном домене).
# Пример: https://editor.example.com
PUBLIC_URL=

# Любая длинная случайная строка: Telegram будет присылать её в заголовке
# X-Telegram-Bot-Api-Secret-Token, сервер по ней отличает настоящие апдейты.
WEBHOOK_SECRET=

# Подпись «by @…» в названиях паков.
PUBLIC_PACK_BOT_USERNAME=swexmakerbot

PORT=3000
# HOST=0.0.0.0

# Всё бесплатно: цены по умолчанию 0. Переменные оставлены на случай,
# если когда-нибудь понадобится вернуть тарифы.
# PRICE_SMALL_RUB=0

# Локальная разработка без Telegram: ALLOW_UNAUTH=1 разрешает неподписанный
# initData. В проде не включать.
# ALLOW_UNAUTH=0
